# C4 Board application environment contract.
# Values are optional because runtime defaults and keychain-backed settings remain authoritative.
# @defaultRequired=false @defaultSensitive=false
# ---

# Frontend feature flags. Prefer PUBLIC_* names; aliases remain for compatibility.
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled)\s*$/i')
PUBLIC_SETTINGS_V1=
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled)\s*$/i')
VITE_SETTINGS_V1=
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled)\s*$/i')
SETTINGS_V1=

# Rig rollout mode. Boolean-like values and canary aliases match the Effect runtime.
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled|canary|pilot|preview)\s*$/i')
PUBLIC_RIG_AGENT_V1=
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled|canary|pilot|preview)\s*$/i')
VITE_RIG_AGENT_V1=
# @type=string(matches='/^\s*(1|true|on|yes|enabled|0|false|off|no|disabled|canary|pilot|preview)\s*$/i')
RIG_AGENT_V1=

# OPY provider fallback. Settings > AI Agent and the OS keychain are preferred.
# @sensitive @type=string(minLength=1)
OPSYDYN_OPENAI_API_KEY=
# Standard OpenAI-compatible fallback used only when the Opsydyn key is absent.
# @sensitive @type=string(minLength=1)
OPENAI_API_KEY=

# Azure Resource Graph pagination tuning.
# @type=number(min=1, max=1000, isInt=true)
OPSYDYN_AZURE_GRAPH_PAGE_SIZE=
# @type=number(min=1, max=500, isInt=true)
OPSYDYN_AZURE_GRAPH_MAX_PAGES=

# Debug-only Tauri layout fixture name.
# @type=string(minLength=1)
C4_VISUAL_FIXTURE=

# Frontend build subprocess heap size in MiB.
# @type=number(min=1, isInt=true)
C4_BOARD_BUILD_HEAP_MB=

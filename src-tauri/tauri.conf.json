{
  "productName": "c4-board",
  "version": "0.0.0",
  "identifier": "com.tauri.devs",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:4321/",
    "beforeBuildCommand": "bun build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "c4-board",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["*"],
          "permissions": [
            "sql:default",
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "sql:allow-close",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:default",
            "core:path:default",
            "dialog:default",
            "dialog:allow-open",
            "fs:default",
            "fs:allow-read-file",
            "fs:allow-read-dir",
            "fs:allow-read-text-file",
            "fs:allow-exists",
            "fs:allow-stat",
            "fs:allow-app-meta",
            "fs:allow-app-meta-recursive",
            {
              "identifier": "fs:scope",
              "allow": [
                { "path": "$APPLOCALDATA" },
                { "path": "$APPLOCALDATA/**" }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:c4board.db"]
    },
    "fs": {}
  }
}

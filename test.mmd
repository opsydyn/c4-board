    %% Developer Workflow
    dev -->|"Opens PR"| pr
    dev -->|"Merges to"| main
    dev -->|"Closes PR"| pr

    %% GitHub Actions Triggers
    pr -->|"on: opened/synchronize"| preview_wf
    main -->|"on: push"| prod_wf
    pr -->|"on: closed"| cleanup_wf

    %% Preview Deployment Flow
    preview_wf -->|"1. Calculate preview URL"| docker_build
    preview_wf -->|"2. Read secrets"| ghsecrets
    preview_wf -->|"3. Build with args"| dockerfile
    docker_build -->|"NEXT_PUBLIC_BASE_URL"| dockerfile
    dockerfile -->|"4. Push image"| acr
    acr -->|"5. Store"| images
    preview_wf -->|"6. az containerapp create/update"| preview1
    preview1 -->|"7. Pull image"| acr
    preview1 -->|"8. Expose FQDN"| preview_url1
    preview_wf -->|"9. Comment PR"| pr

    %% Production Deployment Flow
    prod_wf -->|"1. Build Docker"| docker_build
    docker_build -->|"2. Push"| acr
    prod_wf -->|"3. az containerapp update"| prod_app
    prod_app -->|"4. Pull image"| acr
    prod_app -->|"5. Expose FQDN"| prod_url

    %% Cleanup Flow
    cleanup_wf -->|"az containerapp delete"| preview1
    cleanup_wf -->|"Comment PR"| pr

    %% ChatGPT User Flow
    chatgpt_user -->|"1. Opens widget"| chatgpt_sandbox
    chatgpt_sandbox -->|"2. Proxies request"| preview_url1
    preview_url1 -->|"3. Routes to"| mcp_server
    mcp_server -->|"4. Returns HTML"| widget
    widget -->|"5. Includes assets with absolute URLs"| nextconfig
    chatgpt_sandbox -->|"6. Fetches CSS/JS from absolute URLs"| preview_url1

    %% Next.js Internal Flow
    nextconfig -->|"Configures"| layout
    middleware -->|"Sets headers"| mcp_server
    layout -->|"Renders"| homepage
    layout -->|"Patches fetch/history"| chatgpt_sandbox

    %% Monitoring
    prod_app -->|"Logs"| logs
    preview1 -->|"Logs"| logs
    preview2 -->|"Logs"| logs

    %% Container Relationships
    github_container -->|"Contains"| pr
    github_container -->|"Contains"| main
    github_container -->|"Contains"| gha
    github_container -->|"Contains"| ghsecrets

    workflows_container -->|"Contains"| preview_wf
    workflows_container -->|"Contains"| prod_wf
    workflows_container -->|"Contains"| cleanup_wf

    docker_container -->|"Contains"| docker_build
    docker_container -->|"Contains"| dockerfile

    acr_container -->|"Contains"| acr
    acr_container -->|"Contains"| images

    azure_infra_container -->|"Contains"| rg
    azure_infra_container -->|"Contains"| cae
    azure_infra_container -->|"Contains"| logs

    cae -->|"Hosts"| prod_app
    cae -->|"Hosts"| preview1
    cae -->|"Hosts"| preview2

    nextjs_container -->|"Contains"| nextconfig

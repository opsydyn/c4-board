{
  "extends": "astro/tsconfigs/strictest",
   "plugins": [

      {
        "name": "@effect/language-service"
      }
    ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/ui/*": ["src/ui/*"],
      "@/core/*": ["src/core/*"],
      "@/schema/*": ["src/core/schema/*"],
      "@ui/*": ["src/ui/*"],
      "@core/*": ["src/core/*"],
      "@schema/*": ["src/core/schema/*"]
    },
    "downlevelIteration": true,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "exclude": [
    "src-tauri/target/**/*"
  ]
}

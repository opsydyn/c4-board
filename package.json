{
  "name": "adorable-azimuth",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:reset": "node -e \"const fs=require('node:fs');fs.rmSync('node_modules/.vite',{recursive:true,force:true});fs.rmSync('.astro',{recursive:true,force:true});\" && astro dev --force",
    "start": "astro dev",
    "build": "bun .github/scripts/build-frontend.ts",
    "env:check": "varlock load --agent",
    "env:scan": "varlock scan",
    "env:scan:build": "varlock scan dist",
    "env:scan:staged": "varlock scan --staged",
    "preview": "astro preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:guards": "eslint --config eslint.guards.config.js src/ui/components/C4CanvasContainer.tsx src/ui/hooks/useC4AutosaveMachine.ts src/ui/hooks/useC4CommandsMachine.ts src/ui/hooks/useC4NavigationMachine.ts",
    "astro": "astro",
    "tauri": "tauri",
    "knip": "knip",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "visual:tauri:capture": "bun .github/scripts/capture-tauri-layout.ts",
    "release:surface": "bun .github/scripts/prepare-release-plz-surface.ts",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:check": "bun run --cwd docs check",
    "docs:preview": "bun run --cwd docs preview",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/react": "6.0.1",
    "@copilotkit/react-core": "^1.62.3",
    "@lexical/react": "^0.47.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-spring/web": "^10.1.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@types/dagre": "^0.7.54",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "@vanilla-extract/vite-plugin": "^5.2.4",
    "@visx/curve": "4.0.0",
    "@visx/glyph": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/legend": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "astro": "7.0.7",
    "dagre": "^0.8.5",
    "effect": "^3.21.4",
    "elkjs": "^0.11.1",
    "fuse.js": "^7.4.2",
    "graphql": "^17.0.2",
    "graphql-language-service": "^5.5.2",
    "html-to-image": "1.11.13",
    "lexical": "^0.47.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "react-rnd": "^10.5.3",
    "tone": "^15.1.22",
    "xstate": "^5.32.4"
  },
  "devDependencies": {
    "@antebudimir/eslint-plugin-vanilla-extract": "^1.17.0",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.86.6",
    "@eslint/js": "^10.0.1",
    "@react-types/shared": "^3.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "varlock": "1.13.0",
    "vite": "8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  }
}

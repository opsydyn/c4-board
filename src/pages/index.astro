---
import Layout from "../layouts/Layout.astro";
import {Greet} from "../components/Greet.tsx";
import * as styles from "../styles/index.css.ts";
---

<Layout>
	<main class={styles.main}>
		<div class="row">
			<a href="https://tauri.app" target="_blank">
				<img src="/tauri.svg" class={`logo ${styles.logoTauri}`} alt="Tauri logo" />
			</a>
			<a href="https://astro.build" target="_blank">
				<img
					src="/astro-dark.svg"
					class={`logo ${styles.logoAstro} ${styles.darkModeOnly}`}
					alt="Astro logo"
				/>
				<img
					src="/astro-light.svg"
					class={`logo ${styles.logoAstro} ${styles.lightModeOnly}`}
					alt="Astro logo"
				/>
			</a>
		</div>
		<p>Click on the Tauri and Astro logos to learn more.</p>
		<p>
			Recommended IDE setup:
			<a href="https://code.visualstudio.com/" target="_blank">VS Code</a>
			+
			<a
				href="https://github.com/tauri-apps/tauri-vscode"
				target="_blank"
			>
				Tauri
			</a>
			+
			<a
				href="https://github.com/rust-lang/rust-analyzer"
				target="_blank"
			>
				rust-analyzer
			</a>
				<a
				href="/canvas"

			>
				 Canvas
			</a>
		</p>
		<Greet client:visible />
	</main>
</Layout>
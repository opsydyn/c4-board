---
import Layout from "../layouts/Layout.astro";
import { SavedDiagramsPage } from "../ui/components/SavedDiagramsPage.tsx";
import { pageMain, pageHeading, backLinkContainer, backLink, tableWrapper } from "./saved-diagrams.css";
---

<Layout>
	<main class={pageMain}>
		<h1 class={pageHeading}>
			Saved Diagrams
		</h1>
		<div class={backLinkContainer}>
			<a href="/canvas" class={backLink}>
				← Back to Canvas
			</a>
		</div>
		<div class={tableWrapper}>
			<SavedDiagramsPage client:only="react" />
		</div>
	</main>
</Layout>

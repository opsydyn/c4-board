---
import "../styles/global.css.ts";
import { defaultTheme } from "../styles/theme.css";
import { GlobalMenuListener } from "../components/GlobalMenuListener.tsx";
import { RuntimeBootstrap } from "../components/RuntimeBootstrap.tsx";
---

<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width" />
			<!--
				Resumes the view the app was left in. In <head> and before the app
				mounts, so reopening in Postee is a redirect rather than a visible
				flash of the board.
			-->
			<script>
				import { applyLaunchRoute } from "../ui/launch-route.runtime";
				applyLaunchRoute();
			</script>
			<style>
				html,
				body {
					margin: 0;
					background: #050806;
					color: #c7f5c3;
				}
			</style>
		</head>
	<body class={defaultTheme}>
		<GlobalMenuListener client:only="react" />
		<RuntimeBootstrap client:only="react" />
		<slot />
	</body>
</html>
